diff --git a/mingw-w64-crt/math/arm64ec/ilogbl.c b/mingw-w64-crt/math/arm64ec/ilogbl.c
new file mode 100644
index 000000000..954ec4210
--- /dev/null
+++ b/mingw-w64-crt/math/arm64ec/ilogbl.c
@@ -0,0 +1,36 @@
+/**
+ * This file has no copyright assigned and is placed in the Public Domain.
+ * This file is part of the mingw-w64 runtime package.
+ * No warranty is given; refer to the file DISCLAIMER.PD within this package.
+ */
+/*
+ * ARM64EC keeps the x86_64 'long double', i.e. the 80-bit x87 extended format,
+ * but it has no x87 FPU, so the x86_64 assembly implementations cannot be used.
+ * This file provides the entry point the x86_64 build gets from `math/x86/'.
+ * Because it is only ever compiled for ARM64EC, no conditional is needed here.
+ *
+ * The exponent is a field of the x87 image, so it is read back with integer
+ * instructions and every result is exact.
+ */
+
+#include <math.h>
+
+int ilogbl(long double x)
+{
+    __mingw_ldbl_type_t ld;
+    unsigned long long m;
+    unsigned int e;
+
+    ld.x = x;
+    e = (unsigned int)ld.lh.sign_exponent & 0x7fff;
+    m = ((unsigned long long)(unsigned int)ld.lh.high << 32)
+        | (unsigned int)ld.lh.low;
+
+    if (e == 0x7fff)
+      return FP_ILOGBNAN;   /* infinity or NaN */
+    if (e == 0)
+      /* Zero, or a denormal whose binary point sits at -16382 with the
+         integer bit shifted out: normalize by counting leading zeros.  */
+      return m == 0 ? FP_ILOGB0 : -(int)__builtin_clzll(m) - 16382;
+    return (int)e - 16383;
+}
