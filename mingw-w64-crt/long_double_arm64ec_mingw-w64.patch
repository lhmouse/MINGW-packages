diff --git a/mingw-w64-crt/math/lrintl.c b/mingw-w64-crt/math/lrintl.c
index 0bdd5784f..3ce9a3d1f 100644
--- a/mingw-w64-crt/math/lrintl.c
+++ b/mingw-w64-crt/math/lrintl.c
@@ -10,6 +10,10 @@ long lrintl (long double x)
   long retval = 0l;
 #if __SIZEOF_LONG_DOUBLE__ == __SIZEOF_DOUBLE__
     retval = lrint(x);
+#elif defined(__arm64ec__) || defined(_ARM64EC_)
+    /* ARM64EC keeps the 80-bit x87 'long double' of x86_64 but has no x87
+     * FPU, so there is no `fistpl` to emit. */
+    retval = lrint((double)x);
 #elif defined(_AMD64_) || defined(__x86_64__) || defined(_X86_) || defined(__i386__)
   __asm__ __volatile__ ("fistpl %0"  : "=m" (retval) : "t" (x) : "st");
 #endif
diff --git a/mingw-w64-crt/math/modfl.c b/mingw-w64-crt/math/modfl.c
index 60b9b81b9..55dd69b05 100644
--- a/mingw-w64-crt/math/modfl.c
+++ b/mingw-w64-crt/math/modfl.c
@@ -6,6 +6,7 @@
 #include <fenv.h>
 #include <math.h>
 #include <errno.h>
+#include <stdint.h>
 
 long double
 modfl (long double value, long double* iptr)
@@ -32,6 +33,82 @@ modfl (long double value, long double* iptr)
     "frndint\n"
     "fldcw 4(%%esp)\n"
     "addl $8, %%esp\n\tpop %%eax\n" : "=t" (int_part) : "0" (value) : "eax"); /* round */
+#elif defined(__arm64ec__) || defined(_ARM64EC_)
+  /* No x87 FPU: truncate by masking off the fractional significand bits. */
+  {
+    __mingw_ldbl_type_t in, ip, fp;
+    uint64_t m, mask;
+    unsigned int e, shift;
+
+    in.x = value;
+    e = (unsigned int)in.lh.sign_exponent & 0x7fff;
+    m = ((uint64_t)(uint32_t)in.lh.high << 32) | (uint32_t)in.lh.low;
+
+    if (e == 0x7fff)
+      {
+        /* infinity or NaN */
+        __mingw_ldbl_type_t z;
+        int_part = value;
+        z.x = 0.0L;
+        z.lh.sign_exponent = (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        if (iptr)
+          *iptr = int_part;
+        /* The fractional part of an infinity is a signed zero; that of a NaN
+           is a NaN. */
+        return m == 0x8000000000000000ULL ? z.x : (value - value);
+      }
+    if (e < 16383)
+      {
+        /* |value| < 1 */
+        __mingw_ldbl_type_t z;
+        z.x = 0.0L;
+        z.lh.sign_exponent = (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        if (iptr)
+          *iptr = z.x;
+        return value;
+      }
+    shift = e - 16383;
+    if (shift >= 63)
+      {
+        /* already integral */
+        __mingw_ldbl_type_t z;
+        z.x = 0.0L;
+        z.lh.sign_exponent = (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        if (iptr)
+          *iptr = value;
+        return z.x;
+      }
+    mask = ~((1ULL << (63 - shift)) - 1);
+    ip = in;
+    fp = in;
+    {
+      uint64_t ipm = m & mask, fpm = m & ~mask;
+      ip.lh.low = (unsigned int)ipm;
+      ip.lh.high = (int)(uint32_t)(ipm >> 32);
+      if (fpm == 0)
+        {
+          fp.x = 0.0L;
+          fp.lh.sign_exponent =
+              (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        }
+      else
+        {
+          /* The fractional part has its explicit integer bit clear, which
+             would be an invalid (unnormal) encoding, so shift it up until the
+             integer bit is set and reduce the exponent accordingly. */
+          unsigned int lz = (unsigned int)__builtin_clzll (fpm);
+          fpm <<= lz;
+          fp.lh.low = (unsigned int)fpm;
+          fp.lh.high = (int)(uint32_t)(fpm >> 32);
+          fp.lh.sign_exponent =
+              (short)(((unsigned int)in.lh.sign_exponent & 0x8000) |
+                      ((e - lz) & 0x7fff));
+        }
+    }
+    if (iptr)
+      *iptr = ip.x;
+    return fp.x;
+  }
 #else
   int_part = truncl(value);
 #endif
diff --git a/mingw-w64-crt/math/rintl.c b/mingw-w64-crt/math/rintl.c
index da30c7aa2..ee0502962 100644
--- a/mingw-w64-crt/math/rintl.c
+++ b/mingw-w64-crt/math/rintl.c
@@ -9,6 +9,10 @@ long double rintl (long double x) {
   long double retval = 0.0L;
 #if __SIZEOF_LONG_DOUBLE__ == __SIZEOF_DOUBLE__
     retval = rint(x);
+#elif defined(__arm64ec__) || defined(_ARM64EC_)
+    /* ARM64EC keeps the 80-bit x87 'long double' of x86_64 but has no x87
+     * FPU, so there is no `frndint` to emit. */
+    retval = rint((double)x);
 #elif defined(_AMD64_) || defined(__x86_64__) || defined(_X86_) || defined(__i386__)
   __asm__ __volatile__ ("frndint;": "=t" (retval) : "0" (x));
 #endif
diff --git a/mingw-w64-crt/math/signbitl.c b/mingw-w64-crt/math/signbitl.c
index b4dba713b..5c4a487ce 100644
--- a/mingw-w64-crt/math/signbitl.c
+++ b/mingw-w64-crt/math/signbitl.c
@@ -13,7 +13,12 @@ int __signbitl (long double x) {
     __mingw_ldbl_type_t ld;
     ld.x = x;
     return ((ld.lh.sign_exponent & 0x8000) != 0);
-#elif defined(__arm__) || defined(_ARM_) || defined(__aarch64__) || defined(_ARM64_) || defined(__arm64ec__) || defined(_ARM64EC_)
+#elif defined(__arm64ec__) || defined(_ARM64EC_)
+    /* No x87 FPU: read the sign bit of the 80-bit image with integer ops. */
+    __mingw_ldbl_type_t ld;
+    ld.x = x;
+    return ((ld.lh.sign_exponent & 0x8000) != 0);
+#elif defined(__arm__) || defined(_ARM_) || defined(__aarch64__) || defined(_ARM64_)
     return __signbit(x);
 #elif defined(__i386__) || defined(_X86_)
   unsigned short sw;
diff --git a/mingw-w64-crt/math/truncl.c b/mingw-w64-crt/math/truncl.c
index a28fed3dc..cd57de7c7 100644
--- a/mingw-w64-crt/math/truncl.c
+++ b/mingw-w64-crt/math/truncl.c
@@ -11,6 +11,10 @@ truncl (long double _x)
 {
 #if __SIZEOF_LONG_DOUBLE__ == __SIZEOF_DOUBLE__
   return trunc(_x);
+#elif defined(__arm64ec__) || defined(_ARM64EC_)
+  /* ARM64EC keeps the 80-bit x87 'long double' of x86_64 but has no x87
+   * FPU, so the rounding has to go through `double`. */
+  return trunc((double)_x);
 #else
   long double retval = 0.0L;
   unsigned short saved_cw;
diff --git a/mingw-w64-headers/crt/math.h b/mingw-w64-headers/crt/math.h
index 2bae73861..45b2947a7 100644
--- a/mingw-w64-headers/crt/math.h
+++ b/mingw-w64-headers/crt/math.h
@@ -210,6 +210,9 @@ _CRT_BEGIN_C_HEADER
   {
 #if __SIZEOF_LONG_DOUBLE__ == __SIZEOF_DOUBLE__
     return __builtin_fabsl (x);
+#elif defined(__arm64ec__) || defined(_ARM64EC_)
+    /* No x87 FPU: __builtin_fabsl clears the sign bit with integer ops. */
+    return __builtin_fabsl (x);
 #else
     long double res = 0.0l;
     __asm__ __volatile__ ("fabs;" : "=t" (res) : "0" (x));
