+++ b/mingw-w64-crt/math/arm-common/copysignl.c
@@ -7,5 +7,18 @@
 
 long double copysignl(long double x, long double y)
 {
+#if defined(__arm64ec__) || defined(_ARM64EC_)
+    /* ARM64EC keeps the 80-bit x87 'long double' of x86_64 but has no x87
+     * FPU, so the sign has to be copied with integer instructions on the
+     * memory image: converting `x` to `double` and back would lose the low
+     * eleven bits of the significand. */
+    __mingw_ldbl_type_t sx, sy;
+    sx.x = x;
+    sy.x = y;
+    sx.lh.sign_exponent = (short)(((unsigned int)sx.lh.sign_exponent & 0x7fff)
+                                  | ((unsigned int)sy.lh.sign_exponent & 0x8000));
+    return sx.x;
+#else
     return copysign(x, y);
+#endif
 }
diff --git a/mingw-w64-crt/math/arm-common/ld_fallbacks.c b/mingw-w64-crt/math/arm-common/ld_fallbacks.c
new file mode 100644
index 000000000..885930356
--- /dev/null
+++ b/mingw-w64-crt/math/arm-common/ld_fallbacks.c
@@ -0,0 +1,96 @@
+/**
+ * This file has no copyright assigned and is placed in the Public Domain.
+ * This file is part of the mingw-w64 runtime package.
+ * No warranty is given; refer to the file DISCLAIMER.PD within this package.
+ */
+/*
+ * ARM64EC keeps the x86_64 ABI for 'long double', i.e. the 80-bit x87 extended
+ * format, but neither the compiler backend nor this C library implement the
+ * transcendental functions for it: they are evaluated in 'double' and the
+ * result is converted back, which is what the compiler does for the same
+ * expressions written in C.
+ *
+ * The functions below therefore exist only so that the C library itself can be
+ * linked.  `def-include/func.def.in' hides ucrtbase's binary64 versions behind
+ * F_LD64(), which no longer expands once 'long double' is 80 bits wide, and the
+ * 'long double _Complex' entry points in `complex/' call these symbols because
+ * they are compiled with -fno-builtin.  Without them, `std::complex<long
+ * double>' cannot be linked at all.
+ *
+ * Only ARM64EC needs them: on every other target either ucrtbase provides the
+ * binary64 versions or `arm-common/' already has a real implementation.
+ */
+
+#include <math.h>
+
+#ifdef __arm64ec__
+
+long double acosl(long double x)
+{
+    return (long double)acos((double)x);
+}
+
+long double asinl(long double x)
+{
+    return (long double)asin((double)x);
+}
+
+long double atanl(long double x)
+{
+    return (long double)atan((double)x);
+}
+
+long double atan2l(long double y, long double x)
+{
+    return (long double)atan2((double)y, (double)x);
+}
+
+long double cosl(long double x)
+{
+    return (long double)cos((double)x);
+}
+
+long double sinl(long double x)
+{
+    return (long double)sin((double)x);
+}
+
+long double tanl(long double x)
+{
+    return (long double)tan((double)x);
+}
+
+long double expl(long double x)
+{
+    return (long double)exp((double)x);
+}
+
+long double logl(long double x)
+{
+    return (long double)log((double)x);
+}
+
+long double log10l(long double x)
+{
+    return (long double)log10((double)x);
+}
+
+/* `floor' is exact in 'double' well past the point where the conversion to
+   'double' has already rounded, so the result is either right or, for values
+   beyond the binary64 range, saturated -- the same as any other fallback.  */
+long double floorl(long double x)
+{
+    return (long double)floor((double)x);
+}
+
+long double fmodl(long double x, long double y)
+{
+    return (long double)fmod((double)x, (double)y);
+}
+
+long double scalbnl(long double x, int exp)
+{
+    return (long double)scalbn((double)x, exp);
+}
+
+#endif /* __arm64ec__ */
diff --git a/mingw-w64-crt/math/arm-common/ldexpl.c b/mingw-w64-crt/math/arm-common/ldexpl.c
index 2a2a3771c..10e163ab5 100644
--- a/mingw-w64-crt/math/arm-common/ldexpl.c
+++ b/mingw-w64-crt/math/arm-common/ldexpl.c
@@ -5,8 +5,120 @@
  */
 
 #include <math.h>
+#include <errno.h>
 
 long double ldexpl(long double x, int n)
 {
+#if defined(__arm64ec__) || defined(_ARM64EC_)
+    /* ARM64EC keeps the 80-bit x87 'long double' of x86_64 but has no x87
+     * FPU, so the scaling has to be done with integer instructions on the
+     * memory image: `ldexp` would round the significand to 53 bits and would
+     * not accept exponents outside the range of `double`.  The underflow path
+     * performs gradual underflow with round-to-nearest-even. */
+    __mingw_ldbl_type_t in, out;
+    unsigned long long m;
+    unsigned int e;
+    int ne;
+
+    in.x = x;
+    m = ((unsigned long long)(unsigned int)in.lh.high << 32)
+        | (unsigned int)in.lh.low;
+    e = (unsigned int)in.lh.sign_exponent & 0x7fff;
+
+    if (e == 0x7fff)            /* infinity or NaN */
+        return x;
+    if (m == 0)                 /* zero, including the sign */
+        return x;
+
+    if (e == 0)
+    {
+        /* Denormal or pseudo-denormal: normalize first.  A pseudo-denormal
+         * already has the explicit integer bit set and is a normal number. */
+        if ((m >> 63) == 0)
+        {
+            int lz = __builtin_clzll(m);
+            m <<= lz;
+            e = (unsigned int)(1 - lz);
+        }
+        else
+            e = 1;
+    }
+
+    ne = (int)e + n;
+    if (ne >= 0x7fff)
+    {
+        /* Overflow to infinity. */
+        errno = ERANGE;
+        out.x = 0.0L;
+        out.lh.low = 0;
+        out.lh.high = (int)0x80000000U;
+        out.lh.sign_exponent =
+            (short)(((unsigned int)in.lh.sign_exponent & 0x8000) | 0x7fff);
+        return out.x;
+    }
+
+    out = in;
+    out.lh.low = (unsigned int)m;
+    out.lh.high = (int)(unsigned int)(m >> 32);
+
+    if (ne >= 1)
+    {
+        out.lh.sign_exponent =
+            (short)(((unsigned int)in.lh.sign_exponent & 0x8000) | ne);
+        return out.x;
+    }
+
+    /* The result is a denormal: shift the significand right by (1 - ne)
+     * bits, rounding to nearest with ties to even. */
+    {
+        unsigned int d = (unsigned int)(1 - ne);
+        unsigned long long q, rem, half;
+
+        if (d > 64)
+            q = 0;
+        else if (d == 64)
+            /* m is in [2^63, 2^64), so only a value strictly greater than one
+             * half rounds up. */
+            q = m > 0x8000000000000000ULL ? 1 : 0;
+        else
+        {
+            q = m >> d;
+            rem = m & ((1ULL << d) - 1);
+            half = 1ULL << (d - 1);
+            if (rem > half || (rem == half && (q & 1)))
+                q++;
+        }
+
+        if (q == 0)
+        {
+            errno = ERANGE;
+            out.x = 0.0L;
+            out.lh.low = 0;
+            out.lh.high = 0;
+            out.lh.sign_exponent =
+                (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+            return out.x;
+        }
+
+        errno = ERANGE;
+        if (q >> 63)
+        {
+            /* Rounded up to the smallest normal number. */
+            m = 0x8000000000000000ULL;
+            out.lh.sign_exponent =
+                (short)(((unsigned int)in.lh.sign_exponent & 0x8000) | 0x0001);
+        }
+        else
+        {
+            m = q;
+            out.lh.sign_exponent =
+                (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        }
+        out.lh.low = (unsigned int)m;
+        out.lh.high = (int)(unsigned int)(m >> 32);
+        return out.x;
+    }
+#else
     return ldexp(x, n);
+#endif
 }
