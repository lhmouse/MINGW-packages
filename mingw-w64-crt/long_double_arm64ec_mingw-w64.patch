# ===========================================================================
#  ARM64EC: make 'long double' the x86_64 80-bit x87 format (mingw-w64 CRT)
# ===========================================================================
#
#  Companion to long_double_arm64ec_llvm.patch.  ARM64EC keeps the x86_64 ABI
#  for 'long double' -- a 16-byte slot holding an 80-bit x87 image -- but it has
#  no x87 FPU, and ucrtbase exports every 'long double' entry point with a
#  binary64 'long double'.  Consequently def-include/func.def.in no longer
#  expands F_LD64() on ARM64EC, so the CRT has to supply the whole long double
#  math set itself, exactly as x86_64 does.
#
#  mingw-w64-crt/Makefile.am
#      the ARM64EC section of libmingwex: the new math/arm64ec/ files, plus the
#      plain-C long double sources that used to be x86-only, plus CRT_fp10.c.
#      `math/nextafterl.c', `math/nexttoward.c' and `math/nexttowardf.c' go into
#      libucrt for ARM64EC, matching where x86_64 gets them from.
#  mingw-w64-crt/math/arm64ec/  (new directory, one function per file)
#      acoshl asinhl atanhl ceill exp2l expm1l fmal ilogbl log2l nearbyintl
#      powl remquol scalblnl, and the transcendentals acosl asinl atanl atan2l
#      cosl sinl tanl expl logl log10l plus fmodl floorl scalbnl.
#      These replace the x86_64 assembly in math/x86/; because the directory is
#      only ever compiled for ARM64EC the files carry no conditional at all.
#      `ilogbl' is exact: the exponent is a field of the image.
#  mingw-w64-crt/math/{fabsl,lrintl,rintl,truncl}.c
#      ARM64EC folded into the existing `__SIZEOF_LONG_DOUBLE__ ==
#      __SIZEOF_DOUBLE__' test.  `fabsl' becomes `__builtin_fabsl', which the
#      compiler lowers to an integer sign-bit clear and is therefore exact.
#  mingw-w64-crt/math/signbitl.c
#      ARM64EC takes the x86_64 integer branch: the sign is the top bit of the
#      second word of the image, so it must not go through `__signbit'.
#  mingw-w64-crt/math/arm-common/copysignl.c
#      integer-image copy of the sign bit for ARM64EC.
#  mingw-w64-crt/misc/fesetenv.c
#      ARM64EC keeps the x86_64 floating point environment, so
#      `__mingw_fe_dfl_env' is defined next to `_fpreset' in CRT_fp10.c
#      instead, exactly as for x86_64.
#  mingw-w64-headers/crt/math.h
#      the inline fabsl() uses __builtin_fabsl on ARM64EC as well.
#
#  Note: Makefile.in is deliberately not patched; re-run automake.
#
#  Apply from the mingw-w64 root with
#      git apply long_double_arm64ec_mingw-w64.patch
# ===========================================================================

diff --git a/mingw-w64-crt/Makefile.am b/mingw-w64-crt/Makefile.am
index 082f13da1..832f414ec 100644
--- a/mingw-w64-crt/Makefile.am
+++ b/mingw-w64-crt/Makefile.am
@@ -574,6 +574,11 @@ src_ucrtbasearm64=\
 
 if ARM64EC
 src_ucrtbasearm64+=math/fabsf.c
+# x86_64 also gets the `nextafter' and `nexttoward' families from libucrt rather
+# than libmingwex, because ucrtbase exports them with a binary64 `long double'
+# and F_LD64() hides those.  They are generic code operating on the x87 memory
+# image, so the very same sources serve ARM64EC.
+src_ucrtbasearm64+=math/nextafterl.c math/nexttoward.c math/nexttowardf.c
 endif
 
 # Files included in libmsvcrt-os.a (for msvcrt.dll) on x86_32
@@ -1390,6 +1395,30 @@ src_libmingwexarm64=\
 
 if ARM64EC
 src_libmingwexarm64+=crt/chpe.S
+# `long double` is the 80-bit x87 format on ARM64EC, so ucrtbase's binary64
+# entry points are hidden behind F_LD64() and the whole long double math set has
+# to come from this library, exactly as it does for x86_64.  The files under
+# math/arm64ec/ replace the x86_64 assembly in math/x86/ and are only ever
+# compiled for ARM64EC, so they carry no conditional of their own.
+src_libmingwexarm64+=math/arm64ec/acoshl.c math/arm64ec/acosl.c \
+  math/arm64ec/asinhl.c math/arm64ec/asinl.c math/arm64ec/atan2l.c \
+  math/arm64ec/atanhl.c math/arm64ec/atanl.c math/arm64ec/ceill.c \
+  math/arm64ec/cosl.c math/arm64ec/expl.c math/arm64ec/exp2l.c \
+  math/arm64ec/expm1l.c math/arm64ec/fmal.c math/arm64ec/fmodl.c \
+  math/arm64ec/floorl.c math/arm64ec/ilogbl.c math/arm64ec/logl.c \
+  math/arm64ec/log10l.c math/arm64ec/log2l.c math/arm64ec/nearbyintl.c \
+  math/arm64ec/powl.c math/arm64ec/remquol.c math/arm64ec/scalblnl.c \
+  math/arm64ec/scalbnl.c math/arm64ec/sinl.c math/arm64ec/tanl.c
+# These are plain C that already cope with an 80-bit `long double', so they are
+# shared with the x86_64 build instead of being duplicated in math/arm64ec/.
+src_libmingwexarm64+=math/cbrtl.c math/erfl.c math/fdiml.c math/fmaxl.c \
+  math/fminl.c math/llrintl.c math/llroundl.c math/lrintl.c \
+  math/lroundl.c math/rintl.c math/roundl.c math/tgammal.c math/truncl.c
+# `def-include/func.def.in' imports ucrtbase's `_fpreset' as data once F_LD80()
+# expands, which `crt2.o' cannot call, so the wrapper in this file is needed
+# here exactly as on x86_64.  It also supplies `__mingw_fe_dfl_env', which
+# misc/fesetenv.c therefore does not define for ARM64EC.
+src_libmingwexarm64+=crt/CRT_fp10.c
 src_libmingwexarm64_x64=libarm64/cfguard/guard_dispatch.x86_64.o
 endif
 
diff --git a/mingw-w64-crt/math/arm-common/copysignl.c b/mingw-w64-crt/math/arm-common/copysignl.c
index ea66215f2..27e42c6be 100644
--- a/mingw-w64-crt/math/arm-common/copysignl.c
+++ b/mingw-w64-crt/math/arm-common/copysignl.c
@@ -7,5 +7,19 @@
 
 long double copysignl(long double x, long double y)
 {
+#if defined(__arm64ec__) || defined(_ARM64EC_)
+    /* ARM64EC keeps the 80-bit x87 'long double' of x86_64 but has no x87
+     * FPU, so the sign has to be copied with integer instructions on the
+     * memory image: converting `x` to `double` and back would lose the low
+     * eleven bits of the significand. */
+    __mingw_ldbl_type_t sx, sy;
+
+    sx.x = x;
+    sy.x = y;
+    sx.lh.sign_exponent &= 0x7fff;
+    sx.lh.sign_exponent |= sy.lh.sign_exponent & ~0x7fff;
+    return sx.x;
+#else
     return copysign(x, y);
+#endif
 }
diff --git a/mingw-w64-crt/math/arm64ec/acoshl.c b/mingw-w64-crt/math/arm64ec/acoshl.c
new file mode 100644
index 000000000..554ce0573
--- /dev/null
+++ b/mingw-w64-crt/math/arm64ec/acoshl.c
@@ -0,0 +1,18 @@
