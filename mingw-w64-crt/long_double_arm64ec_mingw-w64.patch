# ===========================================================================
#  ARM64EC: make 'long double' the x86_64 80-bit x87 format (mingw-w64 CRT)
# ===========================================================================
#
#  Companion to long_double_arm64ec_llvm.patch.  ARM64EC has to keep the
#  x86_64 ABI for 'long double' (a 16-byte slot holding an 80-bit x87 image),
#  but it has no x87 FPU, and ucrtbase exports all of its 'long double'
#  entry points with a binary64 'long double'.  These files therefore provide
#  the missing entry points, or route the ARM64EC build to a version that
#  works on the x87 image directly.
#
#  mingw-w64-crt/Makefile.am / Makefile.in
#      crt/CRT_fp10.c into libmingwex (F_LD80 imports `_fpreset' as data),
#      plus the `nextafter'/'nexttoward' family, which def-include/func.def.in
#      hides behind F_LD64() because ucrtbase's copies are binary64.
#  mingw-w64-crt/crt/CRT_fp10.c
#      the wrapper that resets the x87 control word.
#  mingw-w64-crt/gdtoa/strtopx.c
#      strtold() must build a 16-byte 80-bit image on ARM64EC.
#  mingw-w64-crt/math/arm-common/ld_fallbacks.c   (new file)
#      acosl/asinl/atanl/atan2l/cosl/sinl/tanl/expl/logl/log10l/floorl/
#      fmodl/scalbnl evaluated in double: the C library own long double
#      _Complex entry points call them and they are not folded away
#      because complex/ is built with -fno-builtin.
#  mingw-w64-crt/math/arm-common/{copysignl,ldexpl}.c
#  mingw-w64-crt/math/arm64/nearbyintl.c
#  mingw-w64-crt/math/{fabsl,fpclassifyl,frexpl,lrintl,modfl,rintl,signbitl,truncl}.c
#      integer-image implementations of the functions that clang requires not
#      to lose a single bit (`Exact' in EmitSoftX87LongDoubleBuiltin).
#  mingw-w64-headers/crt/math.h
#      the inline fabsl() needs an ARM64EC branch.
#
#  Apply from the mingw-w64 root with
#      git apply long_double_arm64ec_mingw-w64.patch
# ===========================================================================

diff --git a/mingw-w64-crt/Makefile.am b/mingw-w64-crt/Makefile.am
index 082f13da1..b06a74709 100644
--- a/mingw-w64-crt/Makefile.am
+++ b/mingw-w64-crt/Makefile.am
@@ -1390,6 +1390,24 @@ src_libmingwexarm64=\
 
 if ARM64EC
 src_libmingwexarm64+=crt/chpe.S
+# `long double` is the 80-bit x87 format on ARM64EC, so def-include/func.def.in
+# expands F_LD80() and imports ucrtbase's `_fpreset` as data; this file then has
+# to provide the wrapper that resets the x87 control word.
+src_libmingwexarm64+=crt/CRT_fp10.c
+# ucrtbase exports the `nextafter' and `nexttoward' families with a binary64
+# `long double', so their entry points are useless here and def-include/
+# func.def.in hides them behind F_LD64().  The two generic implementations below
+# already operate on the x87 memory image and only need to be compiled in;
+# `nexttowardl' is an alias of `nextafterl' declared in the same file.
+src_libmingwexarm64+=math/nextafterl.c math/nexttoward.c math/nexttowardf.c
+# The same F_LD64() gate hides the long double math functions that the C
+# library's own `long double _Complex' entry points call (they are compiled with
+# -fno-builtin, so the compiler does not fold them).  `arm-common' has exact
+# implementations for four of them; the transcendentals are evaluated in
+# `double' by math/arm-common/ld_fallbacks.c.
+src_libmingwexarm64+=math/arm-common/copysignl.c math/arm-common/log1pl.c \
+  math/arm-common/logbl.c math/arm-common/remainderl.c \
+  math/arm-common/ld_fallbacks.c
 src_libmingwexarm64_x64=libarm64/cfguard/guard_dispatch.x86_64.o
 endif
 
