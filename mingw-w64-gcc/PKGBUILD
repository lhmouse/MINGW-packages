# Helper macros to help make tasks easier #
apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}
# =========================================== #

pkgver() {
  cd "${_sourcedir}"
  _gcc_version=$(head -n 34 gcc/BASE-VER | sed -e 's/.* //' | tr -d '"\n')
  _gcc_date=$(head -n 34 gcc/DATESTAMP | sed -e 's/.* //' | tr -d '"\n')
  printf "%s+%s" "$_gcc_version" "$_gcc_date"
}

prepare() {
  cd "${_sourcedir}"

  apply_patch_with_msg \
    0003-Windows-Follow-Posix-dir-exists-semantics-more-close.patch \
    0012-Handle-spaces-in-path-for-default-manifest.patch \
    0014-gcc-9-branch-clone_function_name_1-Retain-any-stdcall-suffix.patch \
    0024-libgfortran-Guard-locale-restoration-for-formatted-I0.patch \
    0025-libgfortran-Copy-LC_NUMERIC-string-for-formatted-IO.patch

  # Avoid hardcoding /mingw or D:/M/${MINGW_PREFIX} in the final installation.
  # Make GCC fully relocatable.
  # See https://github.com/msys2/MINGW-packages/pull/29280 for details.
  apply_patch_with_msg \
    1000-MSYS2-Set-STANDARD_STARTFILE_PREFIX_1-to-lib.patch

  # Enable diagnostic color under mintty
  # based on https://github.com/BurntSushi/ripgrep/issues/94#issuecomment-261761687
  apply_patch_with_msg \
    0140-gcc-diagnostic-color.patch

  # https://gcc.gnu.org/bugzilla/show_bug.cgi?id=120051
  apply_patch_with_msg \
    3001-fix-codeview-crashes.patch

  # TODO: Pending
  apply_patch_with_msg \
    9103-gcc-mingw-Fix-user-symbol-prefix-handling-for-direct.patch \
    9106-gcc-i386-Restore-RSP-with-ALU-for-TARGET_SEH-in-epil.patch

  # GCC with the MCF thread model
  apply_patch_with_msg \
    9000-gcc-Make-stupid-AT-T-syntax-not-default.patch \
    9001-Prevent-recursive-LoadLibrary-in-libgcc-DLL.patch \
    9002-gcc-mingw-Use-__cxa_atexit.patch \
    9202-libgomp-mingw32-Increase-precision-of-omp_get_wtime-.patch \
    9203-libgomp-mingw32-Fix-plugin-suffix.patch \
    9204-libgomp-mingw32-Implement-cpu_relax-and-doacross_spi.patch \
    9205-libgomp-win32-Add-win32-implementation.patch \
    9207-mingw-w64-Omit-call-to-__main-in-main.patch \
    9208-gcc-mingw-Avoid-.refptr.-for-module-specific-variabl.patch

  autoreconf -fiv
}

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("--disable-libstdcxx-debug")
  else
    _extra_config+=("--enable-libstdcxx-debug")
  fi

  local _boot_ldflags="-static-libstdc++"
  if [[ "${CARCH}" == "i686" ]]; then
    _extra_config+=(
      "--disable-sjlj-exceptions"
      "--with-dwarf2"
    )
    # LDFLAGS is only used for stage1, stage2 and later use --with-boot-ldflags
    # BOOT_LDFLAGS defaults to -static-libstdc++ -static-libgcc
    LDFLAGS+=" -Wl,--large-address-aware"
    _extra_config+=(
      --with-boot-ldflags="-static-libstdc++ -static-libgcc -Wl,--large-address-aware"
    )
    local _arch=corei7
  else
    local _arch=x86-64-v2
  fi

  local _languages="c,c++"
  if [ "$_enable_ada" == "yes" ]; then
    _languages+=",ada"
  fi
  if [ "$_enable_fortran" == "yes" ]; then
    _languages+=",fortran"
  fi
  if [ "$_enable_lto" == "yes" ]; then
    _languages+=",lto"
  else
    _extra_config+=("--disable-lto")
  fi
  if [ "$_enable_objc" == "yes" ]; then
    _languages+=",objc,obj-c++"
  fi
  if [ "$_enable_plugin" == "yes" ]; then
    _extra_config+=("--enable-plugin")
  fi
  if [ "$_enable_rust" == "yes" ]; then
    _languages+=",rust"
  fi
  if [ "$_enable_jit" == "yes" ]; then
    _languages+=",jit"
  fi

  # so libgomp DLL gets built despide static libdl
  export lt_cv_deplibs_check_method='pass_all'

  # local-prefix and native-system-header-dir will be prefixed with sysroot, so don't add ${MINGW_PREFIX} here.
  # --with-build-sysroot has to be an Windows path because it's used by gnatlink.exe, which launch xgcc.exe
  # with `System.OS_Lib.Spawn` which doesn't convert paths.
  ../${_sourcedir}/configure \
    --prefix=${MINGW_PREFIX} \
    --with-sysroot=${MINGW_PREFIX} \
    --with-build-sysroot=$(cygpath -m ${MINGW_PREFIX}) \
    --with-local-prefix=/local \
    --with-native-system-header-dir=/include \
    --libexecdir=${MINGW_PREFIX}/lib \
    --enable-bootstrap \
    --enable-checking=yes \
    --with-arch=${_arch} \
    --with-tune=rocketlake \
    --enable-mingw-wildcard \
    --enable-languages=${_languages} \
    --enable-threads=${_threads} \
    --enable-tls \
    --enable-fully-dynamic-string \
    --enable-libstdcxx-time \
    --disable-libstdcxx-pch \
    --enable-libgomp \
    --disable-libssp \
    --disable-multilib \
    --disable-rpath \
    --disable-win32-registry \
    --disable-nls \
    --disable-werror \
    --disable-symvers \
    --with-system-zlib \
    --with-isl \
    --with-pkgversion="GCC with the MCF thread model, built by LH_Mouse" \
    --with-bugurl="https://github.com/lhmouse/MINGW-packages/issues" \
    "${_extra_config[@]}"

  # While we're debugging -fopenmp problems at least.
  # .. we may as well not strip anything.
  if check_option "strip" "n"; then
    sed -i 's,^STRIP = .*$,STRIP = true,g'                   Makefile
    sed -i 's,^STRIP_FOR_TARGET=.*$,STRIP_FOR_TARGET=true,g' Makefile
  fi

  # https://gcc.gnu.org/onlinedocs/gccint/Makefile.html
  # Avoid all paths passed with -DXXX_DIR to be converted and hardcoded in binaries.
  # See https://github.com/msys2/MINGW-packages/pull/29280 for details.
  MSYS2_ARG_CONV_EXCL='-D' \
    make -O STAGE1_CFLAGS="-O2" \
            profiledbootstrap
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="${srcdir}/${p}/${f#${pkgdir}/}"
    mkdir -vp "$(dirname "${d}")"
    mv -v "${f}" "${d}"
    rmdir -vp --ignore-fail-on-non-empty "$(dirname "${f}")"
  done
}

_install() {
  mkdir -p "${pkgdir}${MINGW_PREFIX}"
  mv -v "${pkgname#${MINGW_PACKAGE_PREFIX}-}"/* "${pkgdir}${MINGW_PREFIX}"
}

_install_GPL3() {
  install -Dm644 "${srcdir}/${_sourcedir}/COPYING3" \
    -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${pkgname#${MINGW_PACKAGE_PREFIX}-}/"
}

_install_RLE() {
  _install_GPL3 # RLE must come with GPL3
  install -Dm644 "${srcdir}/${_sourcedir}/COPYING.RUNTIME" \
    -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${pkgname#${MINGW_PACKAGE_PREFIX}-}/"
}

package_cc-libs() {
  pkgdesc="C++ Standard Library (mingw-w64)"
  depends=(
    "${MINGW_PACKAGE_PREFIX}-libgcc=${pkgver}-${pkgrel}"
    "${MINGW_PACKAGE_PREFIX}-libstdc++=${pkgver}-${pkgrel}"
  )
}

package_gcc() {
  pkgdesc="The GNU Compiler Collection - C and C++ frontends (mingw-w64)"
  depends=(
    "${MINGW_PACKAGE_PREFIX}-binutils"
    "${MINGW_PACKAGE_PREFIX}-crt"
    "${MINGW_PACKAGE_PREFIX}-headers"
    "${MINGW_PACKAGE_PREFIX}-isl"
    "${MINGW_PACKAGE_PREFIX}-gmp"
    "${MINGW_PACKAGE_PREFIX}-mpfr"
    "${MINGW_PACKAGE_PREFIX}-mpc"
    "${MINGW_PACKAGE_PREFIX}-libgcc=${pkgver}-${pkgrel}"
    "${MINGW_PACKAGE_PREFIX}-libstdc++=${pkgver}-${pkgrel}"
    "${MINGW_PACKAGE_PREFIX}-windows-default-manifest"
    $([[ "$_threads" != "posix" ]] || echo "${MINGW_PACKAGE_PREFIX}-winpthreads")
    $([[ "$_threads" != "mcf" ]] || echo "${MINGW_PACKAGE_PREFIX}-mcfgthread")
    "${MINGW_PACKAGE_PREFIX}-zlib"
    "${MINGW_PACKAGE_PREFIX}-zstd"
  )
  optdepends=(
    "${MINGW_PACKAGE_PREFIX}-libatomic"
    "${MINGW_PACKAGE_PREFIX}-libgomp: OpenMP"
    "${MINGW_PACKAGE_PREFIX}-libquadmath: Quad Math"
  )
  provides=("${MINGW_PACKAGE_PREFIX}-cc")
  conflicts=(
    $([[ "$_enable_ada" == "yes" ]] || echo "${MINGW_PACKAGE_PREFIX}-gcc-ada")
    $([[ "$_enable_fortran" == "yes" ]] || echo \
      "${MINGW_PACKAGE_PREFIX}-gcc-fortran" \
      "${MINGW_PACKAGE_PREFIX}-gcc-libgfortran" \
      "${MINGW_PACKAGE_PREFIX}-libgfortran")
    $([[ "$_enable_jit" == "yes" ]] || echo "${MINGW_PACKAGE_PREFIX}-libgccjit")
    $([[ "$_enable_lto" == "yes" ]] || echo \
      "${MINGW_PACKAGE_PREFIX}-gcc-lto-dump" \
      "${MINGW_PACKAGE_PREFIX}-lto-dump")
    $([[ "$_enable_objc" == "yes" ]] || echo "${MINGW_PACKAGE_PREFIX}-gcc-objc")
    $([[ "$_enable_plugin" == "yes" ]] || echo "${MINGW_PACKAGE_PREFIX}-gcc-plugin")
    $([[ "$_enable_rust" == "yes" ]] || echo "${MINGW_PACKAGE_PREFIX}-gcc-rust")
  )
  groups=("${MINGW_PACKAGE_PREFIX}-toolchain")

  cd "build-${MSYSTEM}"

  make DESTDIR="${pkgdir}" install

  (
    cd "${pkgdir}${MINGW_PREFIX}"

    if [[ "$_enable_ada" == "yes" ]]; then
      _pick gcc-ada bin/gnat{,bind,chop,clean,dll,kr,link,ls,make,name,prep}.exe
      _pick gcc-ada ${_libdir}/ada_target_properties
      _pick gcc-ada ${_libdir}/ada{include,lib}/
      _pick gcc-ada ${_libdir}/gnat1.exe
      _pick gcc-ada share/info/gnat{-style,_rm,_ugn}.info
    fi

    if [[ "$_enable_fortran" == "yes" ]]; then
      _pick gcc-fortran bin/{$CHOST-,}gfortran.exe
      _pick gcc-fortran ${_libdir}/finclude/
      _pick gcc-fortran ${_libdir}/libcaf_{shmem,single}.a
      _pick gcc-fortran ${_libdir}/f951.exe
      _pick gcc-fortran ${_libdir}/include/ISO_Fortran_binding.h
      _pick gcc-fortran lib/libgfortran.spec
      _pick gcc-fortran share/info/gfortran.info
      _pick gcc-fortran share/man/man1/gfortran.1
    fi

    if [[ "$_enable_objc" == "yes" ]]; then
      _pick gcc-objc ${_libdir}/include/objc/
      _pick gcc-objc ${_libdir}/cc1obj*
    fi

    if [[ "$_enable_plugin" == "yes" ]]; then
      _pick gcc-plugin ${_libdir}/plugin/
    fi

    if [[ "$_enable_rust" == "yes" ]]; then
      _pick gcc-rust bin/{$CHOST-,}gccrs.exe
      _pick gcc-rust ${_libdir}/crab1.exe
    fi

    # Note: static libraries and import libraries of core runtime libraries (lib{atomic,gcc,quadmath,stdc++})
    # are currently packed into gcc to keep them as small as possible.
    _pick libatomic bin/libatomic*

    _pick libgcc bin/libgcc_s*

    if [[ "$_enable_jit" == "yes" ]]; then
      _pick libgccjit bin/libgccjit*
      _pick libgccjit include/libgccjit*
      _pick libgccjit lib/libgccjit.dll.a
      _pick libgccjit share/info/libgccjit.info
    fi

    if [[ "$_enable_fortran" == "yes" ]]; then
      _pick libgfortran bin/libgfortran*
      _pick libgfortran lib/libgfortran{.dll,}.a
    fi

    _pick libgomp bin/libgomp*
    _pick libgomp lib/libgomp{.dll,}.a
    _pick libgomp share/info/libgomp.info

    if [[ "$_enable_objc" == "yes" ]]; then
      _pick libobjc bin/libobjc*
      _pick libobjc lib/libobjc{.dll,}.a
    fi

    _pick libquadmath bin/libquadmath*

    _pick libstdc++ bin/libstdc++*

    if [[ "$_enable_lto" == "yes" ]]; then
      _pick lto-dump bin/lto-dump.exe
      _pick lto-dump share/man/man1/lto-dump.1
    fi
  )

  if [[ "$_enable_lto" == "yes" ]]; then
    install -dm755 "${pkgdir}"${MINGW_PREFIX}/lib/bfd-plugins/
    ln -v "${pkgdir}"${MINGW_PREFIX}/${_libdir}/liblto_plugin.dll "${pkgdir}"${MINGW_PREFIX}/lib/bfd-plugins/
  fi

  # install the libstdc++ man pages, requires doxygen
  # make -C $CHOST/libstdc++-v3/doc DESTDIR="${pkgdir}" doc-install-man

  # Hardlink
  ln -v "${pkgdir}${MINGW_PREFIX}/bin/"{gcc,cc}.exe
  ln -v "${pkgdir}${MINGW_PREFIX}/bin/"{gcc,${CHOST}-cc}.exe

  if [[ "$_enable_gdb" == "yes" ]]; then
    # Note: GDB doesn't treat ${MINGW_PREFIX}/bin as a safe path by default, may need patching later.
    # Have to install besides the real dll instead of in share/gdb/auto-load as gdb uses the whole Windows path
    # to search for auto-load scripts.
    mv -v "${pkgdir}${MINGW_PREFIX}/lib/libstdc++.dll.a-gdb.py" "${pkgdir}${MINGW_PREFIX}/bin/libstdc++-6.dll-gdb.py"

    # install "custom" system gdbinit
    install -Dm644 "${srcdir}/gdbinit" -t "${pkgdir}${MINGW_PREFIX}/etc/"
    sed -i 's|%GCC_NAME%|gcc-'${_pkgver}'|g' "${pkgdir}${MINGW_PREFIX}/etc/gdbinit"
    if [[ "${CARCH}" == "i686" || "${CARCH}" == "x86_64" ]]; then
      sed -i '/#set disassembly-flavor intel/s/#//' "${pkgdir}${MINGW_PREFIX}/etc/gdbinit"
    fi

    # byte-compile python libraries
    python -m compileall -o 0 -o 1 "${pkgdir}${MINGW_PREFIX}/share/gcc-${_pkgver}/"
  else
    rm -v "${pkgdir}${MINGW_PREFIX}/lib/libstdc++.dll.a-gdb.py"
    rm -vrf "${pkgdir}${MINGW_PREFIX}/share/gcc-${_pkgver}/"
  fi

  _install_RLE
}

package_gcc-ada() {
  pkgdesc="Ada frontend for GCC (GNAT) (mingw-w64)"
  depends=(
    "${MINGW_PACKAGE_PREFIX}-gcc=${pkgver}-${pkgrel}"
    "${MINGW_PACKAGE_PREFIX}-gmp"
    "${MINGW_PACKAGE_PREFIX}-isl"
    "${MINGW_PACKAGE_PREFIX}-libgcc=${pkgver}-${pkgrel}"
    $([[ "$_threads" != "posix" ]] || echo "${MINGW_PACKAGE_PREFIX}-libwinpthread")
    $([[ "$_threads" != "mcf" ]] || echo "${MINGW_PACKAGE_PREFIX}-mcfgthread-libs")
    "${MINGW_PACKAGE_PREFIX}-mpc"
    "${MINGW_PACKAGE_PREFIX}-mpfr"
    "${MINGW_PACKAGE_PREFIX}-zlib"
    "${MINGW_PACKAGE_PREFIX}-zstd"
  )

  _install
  # Ada doesn't use import libraries, instead, they directly link to the DLLs,
  # so we can't simply move them to ${MINGW_PREFIX}/bin, otherwise the Ada compiler may fail to link with them.
  ln -v "${pkgdir}"${MINGW_PREFIX}/${_libdir}/adalib/*.dll "${pkgdir}"${MINGW_PREFIX}/bin/
  _install_RLE
}

package_gcc-fortran() {
  pkgdesc="Fortran frontend for GCC (mingw-w64)"
  depends=(
    "${MINGW_PACKAGE_PREFIX}-gcc=${pkgver}-${pkgrel}"
    "${MINGW_PACKAGE_PREFIX}-gmp"
    "${MINGW_PACKAGE_PREFIX}-isl"
    "${MINGW_PACKAGE_PREFIX}-libgfortran=${pkgver}-${pkgrel}"
    $([[ "$_threads" != "posix" ]] || echo "${MINGW_PACKAGE_PREFIX}-libwinpthread")
    $([[ "$_threads" != "mcf" ]] || echo "${MINGW_PACKAGE_PREFIX}-mcfgthread-libs")
    "${MINGW_PACKAGE_PREFIX}-mpc"
    "${MINGW_PACKAGE_PREFIX}-mpfr"
    "${MINGW_PACKAGE_PREFIX}-zlib"
    "${MINGW_PACKAGE_PREFIX}-zstd"
  )
  optdepends=("${MINGW_PACKAGE_PREFIX}-libgomp: OpenMP")
  provides=("${MINGW_PACKAGE_PREFIX}-fc")
  license=('spdx:GPL-3.0-or-later')

  _install
  mv -v "${pkgdir}"${MINGW_PREFIX}/lib/libgfortran.spec "${pkgdir}"${MINGW_PREFIX}/${_libdir}/
  _install_RLE
}

