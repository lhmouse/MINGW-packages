+
+#ifndef GOMP_SEM_H
+#define GOMP_SEM_H 1
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+struct gomp_sem
+{
+  SRWLOCK mutex;
+  CONDITION_VARIABLE cond;
