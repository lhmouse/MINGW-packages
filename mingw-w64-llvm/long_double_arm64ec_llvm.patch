+llvm::Constant *CodeGenModule::EmitSoftX87LdConstant(
+    const llvm::APFloat &Value) {
+  // The memory image of an x87 extended-precision value is the 64-bit
+  // significand followed by the 16-bit sign/exponent word; the remaining 6
+  // bytes of the 16-byte slot are padding.  As a little-endian integer, the
+  // image is therefore `significand | (sign_exponent << 64)`.
+  llvm::APInt Bits = Value.bitcastToAPInt();
+  assert(Bits.getBitWidth() == 80 && "expected x87 extended precision");
+  return llvm::ConstantInt::get(llvm::IntegerType::get(getLLVMContext(), 128),
+                                Bits.zext(128));
+}
