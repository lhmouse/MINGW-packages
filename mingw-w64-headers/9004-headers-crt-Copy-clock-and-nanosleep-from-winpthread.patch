+#if WINPTHREADS_TIME_BITS == 32
+  return clock_nanosleep32(_C, _F, (const struct _timespec32 *)_T1, (struct _timespec32 *)_T2);
+#else
+  return clock_nanosleep64(_C, _F, (const struct _timespec64 *)_T1, (struct _timespec64 *)_T2);
+#endif
