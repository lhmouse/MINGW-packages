     "fldcw 4(%%esp)\n"
     "addl $8, %%esp\n\tpop %%eax\n" : "=t" (int_part) : "0" (value) : "eax"); /* round */
+#elif defined(__arm64ec__) || defined(_ARM64EC_)
+  /* No x87 FPU: truncate by masking off the fractional significand bits. */
+  {
+    __mingw_ldbl_type_t in, ip, fp;
+    uint64_t m, mask;
+    unsigned int e, shift;
+
+    in.x = value;
+    e = (unsigned int)in.lh.sign_exponent & 0x7fff;
+    m = ((uint64_t)(uint32_t)in.lh.high << 32) | (uint32_t)in.lh.low;
+
+    if (e == 0x7fff)
+      {
+        /* infinity or NaN */
+        __mingw_ldbl_type_t z;
+        int_part = value;
+        z.x = 0.0L;
+        z.lh.sign_exponent = (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        if (iptr)
+          *iptr = int_part;
+        /* The fractional part of an infinity is a signed zero; that of a NaN
+           is a NaN. */
+        return m == 0x8000000000000000ULL ? z.x : (value - value);
+      }
+    if (e < 16383)
+      {
+        /* |value| < 1 */
+        __mingw_ldbl_type_t z;
+        z.x = 0.0L;
+        z.lh.sign_exponent = (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        if (iptr)
+          *iptr = z.x;
