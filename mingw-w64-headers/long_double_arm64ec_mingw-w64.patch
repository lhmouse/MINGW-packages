diff --git a/mingw-w64-crt/math/arm64ec/ldexpl.c b/mingw-w64-crt/math/arm64ec/ldexpl.c
new file mode 100644
index 000000000..4511b4833
--- /dev/null
+++ b/mingw-w64-crt/math/arm64ec/ldexpl.c
@@ -0,0 +1,108 @@
+/**
+ * This file has no copyright assigned and is placed in the Public Domain.
+ * This file is part of the mingw-w64 runtime package.
+ * No warranty is given; refer to the file DISCLAIMER.PD within this package.
+ *
+ * ARM64EC: scale by a power of two with integer instructions only, so that the
+ * 64-bit significand of the x87 extended format is preserved exactly.  The
+ * underflow path performs gradual underflow with round-to-nearest-even.
+ */
+#include <math.h>
+#include <errno.h>
+#include "x87ld.h"
+
+long double ldexpl (long double value, int expn)
+{
+  __mingw_ldbl_type_t in, out;
+  uint64_t m;
+  unsigned int e;
+  int ne;
+
+  in.x = value;
+  m = __x87ld_mantissa (&in);
+  e = __x87ld_exponent (&in);
+
+  if (e == 0x7fff) /* infinity or NaN */
+    return value;
+  if (m == 0) /* zero, including the sign */
+    return value;
+
+  if (e == 0)
+    {
+      /* Denormal or pseudo-denormal: normalize first.  A pseudo-denormal
+         already has the explicit integer bit set and is a normal number. */
+      if ((m >> 63) == 0)
+        {
+          int lz = __builtin_clzll (m);
+          m <<= lz;
+          e = 1 - (unsigned int)lz;
+        }
+      else
+        e = 1;
+    }
+
+  ne = (int)e + expn;
+  if (ne >= 0x7fff)
+    {
+      /* Overflow to infinity, as the x87 does when the exponent wraps. */
+      errno = ERANGE;
+      return __x87ld_signed_inf (&in);
+    }
+
+  if (ne >= 1)
+    {
+      out = in;
+      __x87ld_set_mantissa (&out, m);
+      __x87ld_set_exponent (&out, (unsigned int)ne);
+      return out.x;
+    }
+
+  /* Result is a denormal: shift the significand right by (1 - ne) bits. */
+  {
+    unsigned int d = (unsigned int)(1 - ne);
+    uint64_t q, rem, half;
+
+    if (d > 64)
+      {
+        errno = ERANGE;
+        return __x87ld_signed_zero (&in);
+      }
+    if (d == 64)
+      {
+        /* value in [2^63, 2^64) shifted by 64: at most one unit. */
+        if (m > 0x8000000000000000ULL)
+          {
+            out = in;
+            __x87ld_set_mantissa (&out, 1);
+            __x87ld_set_exponent (&out, 0);
+            return out.x;
+          }
+        errno = ERANGE;
+        return __x87ld_signed_zero (&in);
+      }
+    q = m >> d;
+    rem = m & ((1ULL << d) - 1);
+    half = 1ULL << (d - 1);
+    if (rem > half || (rem == half && (q & 1)))
+      q++;
+    if (q == 0)
+      {
+        errno = ERANGE;
+        return __x87ld_signed_zero (&in);
+      }
+    out = in;
+    if (q >> 63)
+      {
+        /* rounded up to the smallest normal number */
+        __x87ld_set_mantissa (&out, 0x8000000000000000ULL);
+        __x87ld_set_exponent (&out, 1);
+      }
+    else
+      {
+        __x87ld_set_mantissa (&out, q);
+        __x87ld_set_exponent (&out, 0);
+      }
+    errno = ERANGE;
+    return out.x;
+  }
+}
