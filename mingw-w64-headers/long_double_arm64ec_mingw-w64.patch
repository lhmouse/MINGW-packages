diff --git a/mingw-w64-crt/Makefile.am b/mingw-w64-crt/Makefile.am
index c51640a36..199b3295b 100644
--- a/mingw-w64-crt/Makefile.am
+++ b/mingw-w64-crt/Makefile.am
@@ -1387,12 +1387,37 @@ src_libmingwexarm64=\
   math/sincos.c \
   math/sincosf.c \
   math/arm-common/sincosl.c \
-  math/arm64/rint.c         math/arm64/rintf.c \
-  math/arm-common/ldexpl.c
+  math/arm64/rint.c         math/arm64/rintf.c
+
+# ARM64EC has no x87 FPU but keeps the 80-bit `long double` of x86_64, so the
+# long double arithmetic functions convert to `double` (math/arm64ec/*.c) and
+# the ones that must be exact work on the 80-bit image with integer
+# instructions only.
+src_libmingwexarm64_arm64ec=\
+  math/arm64ec/acoshl.c math/arm64ec/acosl.c math/arm64ec/asinhl.c \
+  math/arm64ec/asinl.c math/arm64ec/atan2l.c math/arm64ec/atanhl.c \
+  math/arm64ec/atanl.c math/arm64ec/cbrtl.c math/arm64ec/ceill.c \
+  math/arm64ec/copysignl.c math/arm64ec/coshl.c math/arm64ec/cosl.c \
+  math/arm64ec/erfl.c math/arm64ec/exp2l.c math/arm64ec/expl.c \
+  math/arm64ec/expm1l.c math/arm64ec/fdiml.c math/arm64ec/floorl.c \
+  math/arm64ec/fmal.c math/arm64ec/fmaxl.c math/arm64ec/fminl.c \
+  math/arm64ec/fmodl.c math/arm64ec/hypotl.c math/arm64ec/ldexpl.c \
+  math/arm64ec/lgammal.c math/arm64ec/llrintl.c math/arm64ec/llroundl.c \
+  math/arm64ec/log10l.c math/arm64ec/log1pl.c math/arm64ec/log2l.c \
+  math/arm64ec/logbl.c math/arm64ec/logl.c math/arm64ec/lrintl.c \
+  math/arm64ec/lroundl.c math/arm64ec/nearbyintl.c math/arm64ec/nextafterl.c \
+  math/arm64ec/powl.c math/arm64ec/remainderl.c math/arm64ec/remquol.c \
+  math/arm64ec/rintl.c math/arm64ec/roundl.c math/arm64ec/scalbnl.c \
+  math/arm64ec/sinhl.c math/arm64ec/sinl.c math/arm64ec/sqrtl.c \
+  math/arm64ec/tanhl.c math/arm64ec/tanl.c math/arm64ec/tgammal.c \
+  math/arm64ec/truncl.c \
 
 if ARM64EC
+src_libmingwexarm64+= $(src_libmingwexarm64_arm64ec)
 src_libmingwexarm64+=crt/chpe.S
 src_libmingwexarm64_x64=libarm64/cfguard/guard_dispatch.x86_64.o
+else
+src_libmingwexarm64+=math/arm-common/ldexpl.c
 endif
 
 # These intrinsics are target independent:
diff --git a/mingw-w64-crt/math/arm64ec/acoshl.c b/mingw-w64-crt/math/arm64ec/acoshl.c
new file mode 100644
index 000000000..ceca61429
--- /dev/null
+++ b/mingw-w64-crt/math/arm64ec/acoshl.c
@@ -0,0 +1,17 @@
+/**
+ * This file has no copyright assigned and is placed in the Public Domain.
+ * This file is part of the mingw-w64 runtime package.
+ * No warranty is given; refer to the file DISCLAIMER.PD within this package.
+ *
+ * ARM64EC: the arithmetic functions convert to `double`, evaluate there and
+ * convert back, which is exactly what the C library does for its own long
+ * double entry points.  Functions that must not lose a single bit have
+ * dedicated integer implementations instead (fabsl, signbitl, copysignl,
+ * fpclassify, frexpl, ldexpl, modfl, logbl, ilogbl).
+ */
+#include <math.h>
+
+long double acoshl (long double x)
+{
+  return acosh ((double)x);
+}
