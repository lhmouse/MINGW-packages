+        /* already integral */
+        __mingw_ldbl_type_t z;
+        z.x = 0.0L;
+        z.lh.sign_exponent = (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+        if (iptr)
+          *iptr = value;
+        return z.x;
+      }
+    mask = ~((1ULL << (63 - shift)) - 1);
+    ip = in;
+    fp = in;
+    ip.lh.low = (unsigned int)(m & mask);
+    ip.lh.high = (int)(uint32_t)((m & mask) >> 32);
+    if ((m & ~mask) == 0)
+      {
+        fp.x = 0.0L;
+        fp.lh.sign_exponent = (short)((unsigned int)in.lh.sign_exponent & 0x8000);
+      }
+    else
+      {
+        fp.lh.low = (unsigned int)(m & ~mask);
+        fp.lh.high = (int)(uint32_t)((m & ~mask) >> 32);
+      }
