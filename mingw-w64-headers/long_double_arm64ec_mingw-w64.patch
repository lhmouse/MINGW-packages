diff --git a/mingw-w64-crt/math/arm64ec/x87ld.h b/mingw-w64-crt/math/arm64ec/x87ld.h
new file mode 100644
index 000000000..b0059c35b
--- /dev/null
+++ b/mingw-w64-crt/math/arm64ec/x87ld.h
@@ -0,0 +1,82 @@
+/**
+ * This file has no copyright assigned and is placed in the Public Domain.
+ * This file is part of the mingw-w64 runtime package.
+ * No warranty is given; refer to the file DISCLAIMER.PD within this package.
+ *
+ * ARM64EC has no x87 FPU: `long double` is the x87 80-bit extended format
+ * stored in a 16-byte slot, and every operation on it has to be carried out
+ * either with integer instructions on the memory image (for the functions that
+ * must not lose a single bit) or by converting to `double` first (for the
+ * arithmetic functions, matching what the C library does internally).
+ *
+ * The helpers here only touch the 16-byte image; `__mingw_ldbl_type_t` from
+ * <math.h> provides the field layout.
+ */
+#ifndef _MINGW_ARM64EC_X87LD_H
+#define _MINGW_ARM64EC_X87LD_H
+
+#include <stdint.h>
+#include <math.h>
+
+static __inline__ uint64_t __x87ld_mantissa (const __mingw_ldbl_type_t *p)
+{
+  return ((uint64_t)(uint32_t)p->lh.high << 32) | (uint32_t)p->lh.low;
+}
+
+static __inline__ void __x87ld_set_mantissa (__mingw_ldbl_type_t *p, uint64_t m)
+{
+  p->lh.low = (uint32_t)m;
+  p->lh.high = (uint32_t)(m >> 32);
+}
+
+/* Biased exponent field, 0x7FFF for infinity/NaN and 0 for zero/denormal. */
+static __inline__ unsigned int __x87ld_exponent (const __mingw_ldbl_type_t *p)
+{
+  return (unsigned int)p->lh.sign_exponent & 0x7fff;
+}
+
+static __inline__ unsigned int __x87ld_sign (const __mingw_ldbl_type_t *p)
+{
+  return ((unsigned int)p->lh.sign_exponent & 0x8000) >> 15;
+}
+
+static __inline__ void __x87ld_set_exponent (__mingw_ldbl_type_t *p,
+                                             unsigned int e)
+{
+  p->lh.sign_exponent =
+      (short)(((unsigned int)p->lh.sign_exponent & 0x8000) | (e & 0x7fff));
+}
+
+/* A signed zero with the sign of the given image. */
+static __inline__ long double __x87ld_signed_zero (const __mingw_ldbl_type_t *p)
+{
+  __mingw_ldbl_type_t z;
+  z.x = 0.0L;
+  z.lh.sign_exponent = (short)((unsigned int)p->lh.sign_exponent & 0x8000);
+  return z.x;
+}
+
+/* A signed infinity with the sign of the given image. */
+static __inline__ long double __x87ld_signed_inf (const __mingw_ldbl_type_t *p)
+{
+  __mingw_ldbl_type_t i;
+  i.x = 0.0L;
+  i.lh.low = 0;
+  i.lh.high = (int)0x80000000U;
+  i.lh.sign_exponent = (short)(((unsigned int)p->lh.sign_exponent & 0x8000) | 0x7fff);
+  return i.x;
+}
+
+/* Whether the image is an invalid encoding that the x87 would reject: a
+   "unnormal" (explicit integer bit clear on a non-zero exponent) or a
+   pseudo-NaN/pseudo-infinity (integer bit clear on the maximum exponent). */
+static __inline__ int __x87ld_is_unnormal (const __mingw_ldbl_type_t *p)
+{
+  uint64_t m = __x87ld_mantissa (p);
+  unsigned int e = __x87ld_exponent (p);
+  if (m == 0)
+    return 0;
+  return (m >> 63) == 0 && e != 0;
+}
+
+#endif /* _MINGW_ARM64EC_X87LD_H */
