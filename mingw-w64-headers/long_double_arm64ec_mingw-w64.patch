diff --git a/mingw-w64-crt/math/arm64ec/copysignl.c b/mingw-w64-crt/math/arm64ec/copysignl.c
new file mode 100644
index 000000000..0eb6bf2a9
--- /dev/null
+++ b/mingw-w64-crt/math/arm64ec/copysignl.c
@@ -0,0 +1,21 @@
+/**
+ * This file has no copyright assigned and is placed in the Public Domain.
+ * This file is part of the mingw-w64 runtime package.
+ * No warranty is given; refer to the file DISCLAIMER.PD within this package.
+ *
+ * ARM64EC: copy the sign of `y` onto `x` without touching any other bit, using
+ * integer instructions only.
+ */
+#include <math.h>
+#include "x87ld.h"
+
+long double copysignl (long double x, long double y)
+{
+  __mingw_ldbl_type_t sx, sy;
+  sx.x = x;
+  sy.x = y;
+  sx.lh.sign_exponent =
+      (short)(((unsigned int)sx.lh.sign_exponent & 0x7fff) |
+              ((unsigned int)sy.lh.sign_exponent & 0x8000));
+  return sx.x;
+}
